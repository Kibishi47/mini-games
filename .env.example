# Application
APP_ENV=development
APP_PORT=8080
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=minigames
POSTGRES_PASSWORD=minigames_secret
POSTGRES_DB=minigames_db
DATABASE_URL=postgres://minigames:minigames_secret@postgres:5432/minigames_db?sslmode=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ADDR=redis:6379

# Auth & JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars!
JWT_EXPIRATION_HOURS=72

# Discord OAuth2 (Optionnel en local)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback
